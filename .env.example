# Copy to .env.local — never commit real values.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=souq_uae_dev
# Payments. "mock" is a TEST-ONLY provider (refused in production). Leave unset to offer cash on delivery only.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-string
# Images: hostnames allowed for remote product/category images (comma separated). Uploads in dev use STORAGE_DRIVER=local.
IMAGE_HOSTS=
# STORAGE_DRIVER=local   # development only; add an object-storage adapter for production (see docs/admin.md)
# Secret for the scheduled job that cancels unpaid orders (GET /api/cron/maintenance with Bearer token, every ~5 minutes)
CRON_SECRET=replace-with-another-long-random-string
