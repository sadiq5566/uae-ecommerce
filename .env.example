# Copy to .env.local (development) — never commit real values. In production set these in your host's environment settings.

# --- Site -------------------------------------------------------------------------------------------------------------
# Public base URL (https in production). Used for canonical URLs, sitemap, emails and payment return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- MongoDB (Atlas recommended: replica set, backups, least-privilege user) ------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017
# Use separate databases per environment, e.g. souq_uae_prod / souq_uae_staging / souq_uae_dev
# (the seed script refuses databases whose name doesn't contain dev, local or test)
MONGODB_DB=souq_uae_dev
# Production creates indexes via `npm run db:indexes`; set true to auto-create at runtime instead.
# MONGODB_AUTO_INDEX=false

# --- Payments ---------------------------------------------------------------------------------------------------------
# "stripe" = card payments via Stripe Checkout (set the two keys below). "mock" is a TEST-ONLY provider (refused in production). Leave unset to offer cash on delivery only.
PAYMENT_PROVIDER=mock
# HMAC secret shared with your gateway for webhook signature verification (>= 16 chars). Required when PAYMENT_PROVIDER is set.
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-string

# Stripe: dashboard > Developers > API keys (sk_test_… / sk_live_…) and a webhook endpoint -> https://<site>/api/webhooks/payments
# with events payment_intent.succeeded, payment_intent.payment_failed, payment_intent.canceled, refund.created, refund.updated
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Tabby (Pay in 4) — shown at checkout when all three are set. Keys + merchant code come from your Tabby merchant dashboard / integration manager.
# TABBY_WEBHOOK_SECRET = any random string (>=16 chars) you choose; register it with: npm run tabby:webhook -- https://<site>/api/webhooks/tabby
TABBY_SECRET_KEY=
TABBY_MERCHANT_CODE=
TABBY_WEBHOOK_SECRET=

# --- Scheduled jobs ---------------------------------------------------------------------------------------------------
# Bearer token for GET /api/cron/maintenance (expires unpaid orders, applies scheduled sale prices). Call every ~5 minutes.
CRON_SECRET=replace-with-another-long-random-string

# --- Images -----------------------------------------------------------------------------------------------------------
# Hostnames allowed for remote product/category/article images (comma separated). Also feeds next/image + the CSP.
IMAGE_HOSTS=
IMAGE_BLOCKLIST=
# Development uploads go to public/uploads. Production needs an object-storage adapter (see docs/admin.md).
# STORAGE_DRIVER=local

# --- Not yet implemented (needs your provider account; see docs/deployment.md) ----------------------------------------
# Email (password reset / order emails), SMS, real payment gateway keys, error reporting DSN.

# Email (SMTP). Order confirmations / status updates / return notices go to customers; contact + return requests go to SUPPORT_EMAIL.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Your Store <orders@example.com>
SUPPORT_EMAIL=

# --- New-order alerts to the owner (WhatsApp via CallMeBot + email). Store name = site hostname unless STORE_NAME is set. ---
ADMIN_ALERT_EMAIL=admin@oasishomemarket.org
ADMIN_ALERT_WHATSAPP=+971589857250
# CallMeBot key: from that WhatsApp number send "I allow callmebot to send me messages" to +34 644 51 95 23
CALLMEBOT_APIKEY=
# STORE_NAME=
