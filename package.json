    "db:seed-offers": "node scripts/with-env.cjs scripts/seed-offers.ts",
    "db:add-belts": "node scripts/with-env.cjs scripts/add-belts.ts",
    "db:merge-variants": "node scripts/with-env.cjs scripts/merge-variants.ts",
