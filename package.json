    "remove-images": "node scripts/with-env.cjs scripts/remove-images.ts",
    "tabby:webhook": "node scripts/with-env.cjs scripts/tabby-webhook.ts",
    "db:indexes": "node scripts/with-env.cjs scripts/indexes.ts",
    "db:migrate": "node scripts/with-env.cjs scripts/migrate.ts",
    "seed:demo": "node scripts/with-env.cjs scripts/seed-demo.ts",
    "db:fix-groups": "node scripts/with-env.cjs scripts/fix-variant-groups.ts",
    "import-csv": "node scripts/with-env.cjs scripts/import-csv.ts",
    "seed-pages": "node scripts/with-env.cjs scripts/seed-pages.ts",
